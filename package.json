{
  "name": "raynet-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Raynet CRM integration with Claude AI - Polish language support",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "test:connection": "node test-connection.js",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/server-http.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/server-http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "mcp",
    "raynet",
    "crm",
    "claude-ai",
    "typescript",
    "n8n",
    "telegram-bot",
    "polish",
    "api-integration"
  ],
  "author": "AiPulse Inc. <aipulse.inc@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AiPulseInc/raynet-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/AiPulseInc/raynet-mcp-server/issues"
  },
  "homepage": "https://github.com/AiPulseInc/raynet-mcp-server#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.9",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.6",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "msw": "^2.8.3",
    "nock": "^14.0.0-beta.21",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.0.6"
  }
}
