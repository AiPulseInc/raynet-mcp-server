# Raynet CRM MCP Server - Environment Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git - it's already in .gitignore

# =============================================================================
# RAYNET API CONFIGURATION (REQUIRED)
# =============================================================================

# Raynet API Base URL
# Choose based on your region:
#   Czech:         https://app.raynet.cz/api/v2/
#   Slovak:        https://app.raynetcrm.sk/api/v2/
#   International: https://app.raynetcrm.com/api/v2/
#   EU:            https://eu.raynetcrm.com/api/v2/
RAYNET_INSTANCE_URL=https://app.raynetcrm.com/api/v2/

# Your Raynet instance name (REQUIRED)
# Example: my-company-crm
# This is sent in the X-Instance-Name header with every API request
RAYNET_INSTANCE_NAME=your-instance-name

# Raynet API Username (your email address)
RAYNET_USERNAME=your-email@example.com

# Raynet API Key (KEEP THIS SECRET!)
# Generate in: Raynet CRM → Settings → API Keys
RAYNET_API_KEY=your-secret-api-key-here

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port (default: 3000)
PORT=3000

# Node environment (development, production, test)
NODE_ENV=development

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Maximum retry attempts for failed API requests (default: 3)
RAYNET_MAX_RETRIES=3

# Request timeout in milliseconds (default: 30000 = 30 seconds)
RAYNET_TIMEOUT_MS=30000

# Rate limit buffer - queue requests when remaining < this value (default: 100)
RAYNET_RATE_LIMIT_BUFFER=100

# Log format: "json" for production, "pretty" for development
LOG_FORMAT=pretty

# =============================================================================
# TESTING CONFIGURATION (Optional)
# =============================================================================

# Separate credentials for testing (recommended)
# RAYNET_TEST_INSTANCE_URL=
# RAYNET_TEST_INSTANCE_NAME=
# RAYNET_TEST_USERNAME=
# RAYNET_TEST_API_KEY=

# =============================================================================
# DEPLOYMENT CONFIGURATION (Optional)
# =============================================================================

# Railway deployment token (set in Railway dashboard or GitHub Secrets)
# RAILWAY_TOKEN=

# =============================================================================
# NOTES
# =============================================================================
#
# Security:
# - The .env file is in .gitignore and will NEVER be committed to git
# - Never share your API key in chat, email, or public forums
# - Rotate your API key if you suspect it's been compromised
# - Use separate keys for development and production
#
# How to get your API key:
# 1. Log in to Raynet CRM
# 2. Go to Settings → For Developers → API Keys
# 3. Click "Generate New Key"
# 4. Copy the key and paste it in RAYNET_API_KEY above
#
# How to find your instance name:
# - It's visible in your Raynet CRM URL
# - Example: https://my-company.raynetcrm.com → instance name is "my-company"
#
