# Raynet CRM MCP Server - Environment Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git - it's already in .gitignore

# =============================================================================
# RAYNET API CONFIGURATION (REQUIRED)
# =============================================================================

# Raynet API Base URL
# Choose based on your region:
#   Czech:         https://app.raynet.cz/api/v2/
#   Slovak:        https://app.raynetcrm.sk/api/v2/
#   International: https://app.raynetcrm.com/api/v2/
#   EU:            https://eu.raynetcrm.com/api/v2/
RAYNET_INSTANCE_URL=https://eu.raynetcrm.com/api/v2/

# Your Raynet instance name (REQUIRED)
# Example: my-company-crm
# This is sent in the X-Instance-Name header with every API request
RAYNET_INSTANCE_NAME=your-instance-name

# Raynet API Username (your email address)
RAYNET_USERNAME=your-email@example.com

# Raynet API Key (KEEP THIS SECRET!)
# Generate in: Raynet CRM → Settings → API Keys
RAYNET_API_KEY=your-secret-api-key-here

# =============================================================================
# SERVER CONFIGURATION (OPTIONAL)
# =============================================================================

# Server port (default: 3000)
PORT=3000

# Node environment (development, production, test)
NODE_ENV=development

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log format: 'pretty' (development) or 'json' (production)
LOG_FORMAT=pretty

# Tool mode: 'mobile' (25 essential tools, default) or 'full' (all 91 tools)
# Mobile mode is optimized for field sales reps using Claude, Telegram, or n8n
TOOL_MODE=mobile

# =============================================================================
# HTTP TRANSPORT AUTHENTICATION (OPTIONAL)
# =============================================================================

# Bearer token for HTTP transport (/mcp endpoint)
# Required for remote deployment (Railway, n8n, Telegram bots)
# If not set, authentication is disabled (development only!)
# MCP_API_KEY=your-secret-bearer-token-here

# CORS allowed origin (default: * — allows all origins)
# Set to a specific origin in production, e.g. https://your-n8n-instance.com
# CORS_ORIGIN=*

# =============================================================================
# RATE LIMITING (OPTIONAL)
# =============================================================================

# Maximum API requests per day (default: 24000)
# Rate limiting is built into the server and respects Raynet's daily limits
RAYNET_RATE_LIMIT_DAILY=24000

# Request timeout in milliseconds (default: 30000)
RAYNET_TIMEOUT_MS=30000

# Maximum retries for failed requests (default: 3)
RAYNET_MAX_RETRIES=3
