        "specifyHeaders": "json",
        "jsonHeaders": "{\n  \"Content-Type\": \"application/json\",\n  \"Accept\": \"application/json, text/event-stream\"\n}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"raynet_list_companies\",\n    \"arguments\": {\n      \"limit\": {{ $fromAI('limit', 10, 'number') }}\n    }\n  },\n  \"id\": {{ Math.floor(Math.random() * 10000) }}\n}",
